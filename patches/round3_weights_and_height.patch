+def gait_diagonal_coordination(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    feet_body_names: list[str] | None = None,
+    command_name: str = "base_velocity",
+    contact_threshold: float = 0.5,
+    contact_softness: float = 10.0,
+    cmd_speed_gate: float = 0.15,
+) -> torch.Tensor:
+    """Reward trot-like diagonal foot coordination: FL+RR in sync, FR+RL in sync, and roughly one
+    diagonal pair supporting the robot while the other swings.
+
+    Uses a soft (sigmoid) contact value per foot instead of a hard boolean, since a hard threshold flickers
+    around ``contact_threshold``. Only active while the robot is actually commanded to move linearly
+    (``cmd_speed_gate``) -- without this gate, the policy could learn to shuffle its feet while a near-zero
+    velocity command asks it to stand still, just to collect this reward.
+
+    Args:
+        sensor_cfg: Contact sensor configuration covering all robot bodies (indices must align with
+            ``asset_cfg`` -- same requirement as ``foot_sliding_exp``/``foot_lift_exp``).
+        feet_body_names: **Required**, and must be given in ``["FL_foot", "FR_foot", "RL_foot", "RR_foot"]``
+            order -- the diagonal pairing (FL+RR vs FR+RL) is determined positionally, not by name.
+        command_name: Name of the velocity command used for the speed gate.
+        contact_threshold: Contact-force magnitude (N) at which the soft contact value crosses 0.5.
+        contact_softness: Larger values make the sigmoid transition (swing -> stance) sharper.
+        cmd_speed_gate: Minimum commanded horizontal speed (m/s) below which the gait reward is zeroed out.
+    """
+    # extract the used quantities (to enable type-hinting)
+    asset: Articulation = env.scene[asset_cfg.name]
+    contact_sensor = env.scene.sensors[sensor_cfg.name]
+
+    if feet_body_names is None or len(feet_body_names) != 4:
+        raise ValueError(
+            "gait_diagonal_coordination requires 'feet_body_names' as exactly "
+            "[\"FL_foot\", \"FR_foot\", \"RL_foot\", \"RR_foot\"] (diagonal pairing is positional)."
+        )
+    feet_list, resolved_names = asset.find_bodies(feet_body_names)
+    num_art_bodies = asset.data.body_com_vel_w.shape[1]
+    for fid in feet_list:
+        if fid < 0 or fid >= num_art_bodies:
+            raise RuntimeError(
+                f"Resolved foot body index {fid} is out of bounds [0, {num_art_bodies}). "
+                f"feet_body_names={feet_body_names}, resolved_names={resolved_names}"
+            )
+
+    # --- map sensor body names -> feet local sensor indices (same pattern as foot_sliding_exp) ---
+    sensor_name_to_idx = {name: i for i, name in enumerate(contact_sensor.body_names)}
+    n_feet = len(resolved_names)
+    foot_to_sensor = torch.zeros(
+        len(contact_sensor.body_names), n_feet, dtype=torch.float32, device=asset.device
+    )
+    for art_idx, fname in enumerate(resolved_names):
+        if fname in sensor_name_to_idx:
+            foot_to_sensor[sensor_name_to_idx[fname], art_idx] = 1.0
+
+    # --- per-foot contact force magnitude, in the fixed FL/FR/RL/RR order given by feet_body_names ---
+    net_forces = contact_sensor.data.net_forces_w  # (N, num_sensor_bodies, 3)
+    force_mag_all = torch.norm(net_forces, dim=-1)  # (N, num_sensor_bodies)
+    force_mag_per_foot = force_mag_all @ foot_to_sensor  # (N, n_feet) -- order: FL, FR, RL, RR
+
+    # --- soft contact value: ~0 in swing, ~1 in stance ---
+    c = torch.sigmoid((force_mag_per_foot - contact_threshold) / contact_softness)
+    c_fl, c_fr, c_rl, c_rr = c[:, 0], c[:, 1], c[:, 2], c[:, 3]
+
+    # diagonal synchronization: high when FL~=RR and FR~=RL
+    sync = 1.0 - (torch.abs(c_fl - c_rr) + torch.abs(c_fr - c_rl)) / 2.0
+    # alternating support: high when roughly one diagonal pair supports (D1+D2 ~= 1), not all-up/all-down
+    d1 = (c_fl + c_rr) / 2.0
+    d2 = (c_fr + c_rl) / 2.0
+    support = 1.0 - torch.abs(d1 + d2 - 1.0)
+
+    gait = sync * support  # bounded in [0, 1]
+
+    # --- command-speed gate: only reward gait coordination while actually commanded to move ---
+    cmd = env.command_manager.get_command(command_name)
+    cmd_speed = torch.norm(cmd[:, :2], dim=-1)
+    gate = (cmd_speed > cmd_speed_gate).float()
+
+    reward = gait * gate
+    diagnostics.log_step(env, "reward.gait_diagonal_coordination", reward)
+    return reward
+
