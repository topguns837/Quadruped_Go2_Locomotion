# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Deliberate exception: the combined Go2 + Open Manipulator X asset (with the corrected arm mounting
# position) has no other distribution mechanism today -- unlike most USD assets here, it's not pulled from
# Nucleus at runtime, so unitree_go2witharm_cfg.py can't load the robot at all without this file present.
# Single-file exception, not a blanket unblock -- every other USD file in the repo stays ignored.
!/source/quadruped_go2_locomotion/quadruped_go2_locomotion/tasks/manager_based/quadruped_go2_locomotion/resources/go2withArm/go2withOpenXstatic.usd

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
*.vscode/
*.claude/
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/rsl_rl/
# **/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Trained model checkpoints
**/*.pt
**/*.pth

# Curated trained models checked into the repo on purpose -- see models/README.md. Only the run's final
# checkpoint + exported policy should actually be staged per run; intermediate model_N.pt checkpoints stay
# untracked even here (that's a staging discipline, not enforced by a pattern -- there's no reliable way to
# gitignore "everything except the highest N" by filename).
!models/**/*.pt

# Teleop Recorded Dataset
/datasets/

# Tests
tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*
